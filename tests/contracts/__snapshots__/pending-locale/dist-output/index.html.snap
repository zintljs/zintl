<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><title>Pending locale fixture</title>  <script type="module" crossorigin src="/assets/index.js"></script>

  <!--zintl-bootstrap-->
    <script id="zintl-projection">
      (function() {
        const l = localStorage.getItem('zintl-locale') || 'en';
        const originals = {
        title: document.title,
      };
        const preloads = {"ar":["assets/entry_b_785c57fb4811.js"]};
      function preload(locale) {
        const urls = preloads[locale] || [];
        for (const url of urls) {
          const link = document.createElement("link");
          link.rel = "modulepreload";
          link.href = url;
          document.head.appendChild(link);
        }
      }
        function apply(locale) {
          document.documentElement.lang = locale;
        }
        window.__zintlApplyHtml = apply;
        if (l !== 'en') {
          apply(l);
          preload(l);
        }
      })();
    </script>
  </head>
  <body>
    <div id="app"></div>
  </body>
</html>
