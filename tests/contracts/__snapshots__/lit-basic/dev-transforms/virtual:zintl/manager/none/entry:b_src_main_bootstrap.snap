export default (() => {
  const manager = { id: "b_src_main_bootstrap", loader: (locale) => {
      switch(locale) { 
        case "en":
          return {
    "b_src_my_element": {
      "Edit <code>src/my-element.ts</code> and save to test\n            <code>HMR</code>": "Edit <code>src/my-element.ts</code> and save to test\n            <code>HMR</code>",
      "Count is {count}": (params) => {
    const { count } = params;
    return `Count is ${params['count']}`;
  },
      "Documentation": "Documentation",
      "Your questions, answered": "Your questions, answered",
      "Explore Vite": "Explore Vite",
      "Learn more": "Learn more",
      "Connect with us": "Connect with us",
      "Join the Vite community": "Join the Vite community",
    },
  };
                case "ar":
          return import(/* @vite-ignore */ "virtual:zintl/content/ar/entry:b_src_main_bootstrap").then(m => m.default);
        case "es":
          return import(/* @vite-ignore */ "virtual:zintl/content/es/entry:b_src_main_bootstrap").then(m => m.default);
        case "zh":
          return import(/* @vite-ignore */ "virtual:zintl/content/zh/entry:b_src_main_bootstrap").then(m => m.default);
        default: return {};
      }
    }, manifest: [] };
  if (typeof globalThis !== "undefined" && globalThis.__zintl_active) {
    globalThis.__zintl_active.registerLoader(manager.id, manager.loader);
  }
  return manager;
})();
if (import.meta.hot) {
  import.meta.hot.accept((newModule) => {
    if (newModule?.default && typeof globalThis !== "undefined" && globalThis.__zintl_active) {
      globalThis.__zintl_active.registerLoader(newModule.default.id, newModule.default.loader);
    }
  });
}