import "../style.js";
//#region examples/vanilla-ssr/src/counter.ts?zintl-multiplex=ar
function setupCounter(element) {
	let counter = 0;
	const setCounter = (count) => {
		counter = count;
		element.innerHTML = `العدد هو ${counter}`;
	};
	element.addEventListener("click", () => setCounter(counter + 1));
	setCounter(0);
}
//#endregion
//#region examples/vanilla-ssr/src/entry-client.ts?zintl-multiplex=ar
setupCounter(document.querySelector("#counter"));
//#endregion
