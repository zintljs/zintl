/**
* The solid-ts template renders immediately. The only addition is the trust
* anchor: `zintl(lang)` is awaited first, so the tree is never painted
* untranslated.
*/
async function bootstrap() {
	const lang = new URLSearchParams(window.location.search).get("lang") || "en";
	await (globalThis.__zintl_inst = loadI18nInstance({
		locale: lang,
		loaders: { ["b_f1bc61690f0b"]: entry_b_f1bc61690f0b_default.loader }
	}));
	render(() => createComponent(App, {}), document.getElementById("root"));
}
