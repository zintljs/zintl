<script lang="ts">
import _zintl_mgr_b_src_main_bootstrap from "virtual:zintl/manager/none/entry:b_src_main_bootstrap";
import { loadI18nInstance } from "virtual:zintl/runtime/internal";

  

  interface Props {
    lang: string;
    onswitch: (lang: string) => void;
  }

  let { lang, onswitch }: Props = $props();

  const locales = [
    { id: "en", name: "English" },
    { id: "ar", name: "العربية" },
    { id: "es", name: "Español" },
    { id: "zh", name: "中文" },
  ];

  const handleSwitch = async (newLang: string) => {
    const url = new URL(window.location.href);
    url.searchParams.set("lang", newLang);
    window.history.pushState({}, "", url);
    await (globalThis.__zintl_inst = loadI18nInstance({ locale: newLang, loaders: { ["b_src_main_bootstrap"]: _zintl_mgr_b_src_main_bootstrap.loader } }));
    onswitch(newLang);
  };


if (import.meta.hot) {
  import.meta.hot.accept(() => {
    // src/lib/LocaleSwitcher.svelte declares a trust anchor and this framework's mount is not
    // replayable: re-running it would mount again instead of replacing.
    import.meta.hot.invalidate();
  });
}
</script>

<!-- @zintl-ignore -->
<section id="header">
  <div id="switcher" class="switcher">
    {#each locales as l}
      <button
        class={lang === l.id ? "active" : ""}
        onclick={() => handleSwitch(l.id)}
      >
        {l.name}
      </button>
    {/each}
  </div>
  <div class="vertical-ticks"></div>
  <div class="icon-border">
    <svg class="icon" role="img" aria-hidden="true">
      <use href="/icons.svg#translate-icon"></use>
    </svg>
  </div>
</section>
<div class="ticks"></div>