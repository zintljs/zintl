<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vite with TypeScript — Zintl example</title>
    <script type="module" crossorigin src="/assets/index.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-DrER1qNV.css">
  
  <!--zintl-bootstrap-->
    <script id="zintl-projection">
      (function() {
        const known = ["en","ar","es","zh"];
        const base = "/";
        const path = location.pathname;
        const below = base !== '/' && path.indexOf(base) === 0 ? path.slice(base.length) : path;
        const seg = below.split('/').filter(Boolean)[0];
        const l = (known.indexOf(seg) !== -1 ? seg : null) || localStorage.getItem('zintl-locale') || 'en';
        const rtl = ["ar"];
        const deltas = {"ar":{"title":"Vite مع TypeScript — مثال زينتل"},"es":{"title":"Vite con TypeScript — Ejemplo de Zintl"},"zh":{"title":"Vite 搭配 TypeScript — Zintl 示例"}};
        const originals = {
        title: document.title,
      };
        const preloads = {"ar":["/assets/entry_b_ae1e7cbb2f74.js"],"es":["/assets/entry_b_ae1e7cbb2f742.js"],"zh":["/assets/entry_b_ae1e7cbb2f743.js"]};
      function preload(locale) {
        const urls = preloads[locale] || [];
        for (const url of urls) {
          const link = document.createElement("link");
          link.rel = "modulepreload";
          link.href = url;
          document.head.appendChild(link);
        }
      }
        function apply(locale) {
          document.documentElement.dir = rtl.includes(locale) ? 'rtl' : 'ltr';
          document.documentElement.lang = locale;
          const hasText = v => typeof v === "string" && v.trim();
          const delta = deltas[locale];
          if (delta) {
            document.title = hasText(delta.title)
              ? delta.title
              : originals.title;
          } else {
            document.title = originals.title;
          }
        }
        window.__zintlApplyHtml = apply;
        if (l !== 'en') {
          apply(l);
          preload(l);
        }
      })();
    </script>
  </head>
  <body>
    <div id="app"></div>
  </body>
</html>
