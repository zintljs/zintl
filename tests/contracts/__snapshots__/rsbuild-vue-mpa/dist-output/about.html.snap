<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About — Rsbuild with Vue — Zintl multi-page example</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"><script defer src="/static/js/lib-vue.js"></script><script defer src="/static/js/7.js"></script><script defer src="/static/js/0.js"></script><script defer src="/static/js/about.js"></script><link href="/static/css/about.css" rel="stylesheet"><!--zintl-bootstrap-->
    <script id="zintl-projection">
      (function() {
        const known = ["en","ar","es","zh"];
        const base = "/";
        const path = location.pathname;
        const below = base !== '/' && path.indexOf(base) === 0 ? path.slice(base.length) : path;
        const seg = below.split('/').filter(Boolean)[0];
        const l = (known.indexOf(seg) !== -1 ? seg : null) || localStorage.getItem('zintl-locale') || 'en';
        const rtl = ["ar"];
        const deltas = {"ar":{"title":"من نحن — Rsbuild مع Vue — مثال زينتل متعدد الصفحات"},"es":{"title":"Acerca de — Rsbuild con Vue — Ejemplo multipágina de Zintl"},"zh":{"title":"关于 — Rsbuild 搭配 Vue — Zintl 多页面示例"}};
        const originals = {
        title: document.title,
      };
        function apply(locale) {
          document.documentElement.dir = rtl.includes(locale) ? 'rtl' : 'ltr';
          document.documentElement.lang = locale;
          const hasText = v => typeof v === "string" && v.trim();
          const delta = deltas[locale];
          if (delta) {
            document.title = hasText(delta.title)
              ? delta.title
              : originals.title;
          } else {
            document.title = originals.title;
          }
        }
        window.__zintlApplyHtml = apply;
        if (l !== 'en') {
          apply(l);
        }
      })();
    </script>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
