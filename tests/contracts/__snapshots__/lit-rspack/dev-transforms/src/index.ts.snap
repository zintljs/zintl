import { loadI18nInstance } from "virtual:zintl/runtime/internal";
import _zintl_mgr_b_src_index_bootstrap from "virtual:zintl/manager/none/entry:b_src_index_bootstrap";

import "./app-root.ts";

async function bootstrap() {
  const lang = new URLSearchParams(window.location.search).get("lang") || "en";
  await (globalThis.__zintl_inst = loadI18nInstance({ locale: lang, loaders: { ["b_src_index_bootstrap"]: _zintl_mgr_b_src_index_bootstrap.loader } }));
  document.getElementById("root")!.appendChild(document.createElement("app-root"));
}

void bootstrap();