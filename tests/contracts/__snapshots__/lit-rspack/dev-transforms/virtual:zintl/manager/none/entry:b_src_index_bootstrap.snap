export default (() => {
  const manager = { id: "b_src_index_bootstrap", loader: (locale) => {
      switch(locale) { 
        case "en":
          return {
    "b_src_app_root": {
      "Get started": "Get started",
      "Edit <code>src/index.ts</code> and save to test <code>HMR</code>": "Edit <code>src/index.ts</code> and save to test <code>HMR</code>",
    },
  };
                case "ar":
          return import("virtual:zintl/content/ar/entry:b_src_index_bootstrap").then(m => m.default);
        case "es":
          return import("virtual:zintl/content/es/entry:b_src_index_bootstrap").then(m => m.default);
        case "zh":
          return import("virtual:zintl/content/zh/entry:b_src_index_bootstrap").then(m => m.default);
        default: return {};
      }
    }, manifest: [] };
  if (typeof globalThis !== "undefined" && globalThis.__zintl_active) {
    globalThis.__zintl_active.registerLoader(manager.id, manager.loader);
  }
  return manager;
})();
if (import.meta.webpackHot) { import.meta.webpackHot.accept(); }