import { _t, loadI18nInstance } from "virtual:zintl/runtime/internal";
import _zintl_mgr_b_src_main_render from "virtual:zintl/manager/none/entry:b_src_main_render";

import { setupCounter } from "./counter.ts";
import { setupSwitcher } from "./switcher.ts";
import aboutText from "./about.txt?raw";

async function render() {
  const lang = new URLSearchParams(window.location.search).get("lang") || "en";
  await (globalThis.__zintl_inst = loadI18nInstance({ locale: lang, loaders: { ["b_src_main_render"]: _zintl_mgr_b_src_main_render.loader } }));

  document.querySelector<HTMLDivElement>("#app")!.innerHTML = `
<section id="header">
  <div id="switcher" class="switcher"></div>
</section>

<section id="center">
  <div>
    <h1>${_t("Get started", { _mgr: _zintl_mgr_b_src_main_render, _bId: "b_src_main_render" })}</h1>
    <p>${_t("Edit <code>src/main.ts</code> and save to test <code>HMR</code>", { _mgr: _zintl_mgr_b_src_main_render, _bId: "b_src_main_render", _tags: [{"alias":"code","originalOpen":"<code>","tagName":"code"}] })}</p>
  </div>
  <button id="counter" type="button" class="counter"></button>
</section>

<section id="next-steps">
  <div id="docs">
    <h2>${_t("Documentation", { _mgr: _zintl_mgr_b_src_main_render, _bId: "b_src_main_render" })}</h2>
    <p>${_t("Your questions, answered", { _mgr: _zintl_mgr_b_src_main_render, _bId: "b_src_main_render" })}</p>
    <p id="about">${aboutText}</p>
  </div>
</section>
`;

  setupCounter(document.querySelector<HTMLButtonElement>("#counter")!);
  setupSwitcher(document.querySelector<HTMLDivElement>("#switcher")!, (newLang) => {
    const url = new URL(window.location.href);
    url.searchParams.set("lang", newLang);
    window.history.pushState({}, "", url);
    void render();
  });
}

void render();