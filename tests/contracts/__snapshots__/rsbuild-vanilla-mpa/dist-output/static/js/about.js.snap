        },
        {
            id: "es",
            name: "Español"
        },
        {
            id: "zh",
            name: "中文"
        }
    ];
    element.innerHTML = locales.map((l)=>`
    <!-- @zintl-ignore -->
    <button data-lang="${l.id}" class="${lang === l.id ? "active" : ""}">
      ${l.name}
    </button>
  `).join("");
    element.querySelectorAll("button").forEach((btn)=>{
        btn.addEventListener("click", ()=>{
            const newLang = btn.dataset.lang;
            onSwitch(newLang);
        });
    });
}


