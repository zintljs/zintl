import { _t } from "virtual:zintl/runtime/internal";

  import LocaleSwitcher from "./lib/LocaleSwitcher.svelte";

  let activeLang = $state(new URLSearchParams(window.location.search).get("lang") || "en");
  let count = $state(0);

