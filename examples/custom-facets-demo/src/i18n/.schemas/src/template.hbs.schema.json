{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "Hello {name}, welcome to {site}!": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Variables: {name}, {site}"
    },
    "This is a plain text node in Handlebars extracted by Zintl.": {
      "type": "string"
    },
    "Welcome to Handlebars!": {
      "type": "string"
    }
  },
  "required": [
    "Hello {name}, welcome to {site}!",
    "This is a plain text node in Handlebars extracted by Zintl.",
    "Welcome to Handlebars!"
  ],
  "additionalProperties": false
}
