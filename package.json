{
  "name": "zintl-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp lint && knip && vp run build && vp test  && vp fmt && vp run bench ",
    "dev": "pnpm run -F '@zintl/*' -F 'zintl' -F 'website' --parallel dev ",
    "build": "vp run -r build",
    "bench:write": "WRITE_BASELINE=1 NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "bench": "NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "deps:lint": "knip",
    "deps:fix": "knip --fix && pnpm store prune",
    "skills": "vpx skills@latest",
    "prepare": "vp config",
    "change": "changeset",
    "change:deps": "node scripts/auto-changeset.js",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "knip": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
