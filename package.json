{
  "name": "zintl-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run -F '@zintl/*' -F 'zintl' -F 'website' --parallel dev ",
    "build": "vpr --transitive zintl#build && vpr --transitive @zintl/testing#build",
    "ready": "vp lint && knip && vp run build && vp test  && vp fmt && vp run bench ",
    "test:contracts": "vp test --config=tests/vitest.config.ts",
    "dev:examples": "pnpm run --filter='./examples/*' --parallel dev",
    "build:examples": "vpr --filter='./examples/*' build",
    "test:examples": "vpr test:contracts",
    "ready:examples": "vpr build:examples && vpr test:examples",
    "ci": "vpr ready && vpr ready:examples",
    "bench": "NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "bench:write": "WRITE_BASELINE=1 NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "deps:lint": "knip",
    "deps:fix": "knip --fix && pnpm store prune",
    "skills": "vpx skills@latest",
    "prepare": "vp config",
    "change": "changeset",
    "change:deps": "node scripts/auto-changeset.js",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@zintl/testing": "workspace:*",
    "knip": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
