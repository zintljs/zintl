{
  "name": "zintl-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp lint && knip && vp run build && vp test  && vp fmt && vp run bench ",
    "dev": "pnpm run -F '@zintl/*' -F 'zintl' -F 'website' --parallel dev ",
    "build": "vp run -r build",
    "bench:write": "WRITE_BASELINE=1 NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "bench": "NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "deps:lint": "knip",
    "deps:fix": "knip --fix && pnpm store prune",
    "skills": "vpx skills@latest",
    "prepare": "vp config",
    "change": "changeset",
    "change:deps": "node scripts/auto-changeset.js",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "knip": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
