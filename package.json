{
  "name": "zintl-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run -F '@zintljs/*' -F 'zintljs' -F 'website' --parallel dev ",
    "build": "vpr --transitive zintljs#build && vpr --transitive @zintljs/testing#build",
    "//verify": "Shared gate. Everything MUST be built before linting: type-aware lint resolves workspace imports through each package's dist/*.d.mts, and it also covers examples/ — which need @zintl-examples/* dists and vinext's generated .next types. On a fresh checkout, linting first yields ~172 phantom 'Cannot find module' errors.",
    "verify": "vpr build:examples && vp lint && knip && vp test && vp fmt --check",
    "ready": "vpr build:examples && vp lint && knip && vp test && vp fmt && vp run bench",
    "test:contracts": "vp test --config=tests/vitest.config.ts",
    "dev:examples": "pnpm run --filter='./examples/*' --parallel dev",
    "build:examples": "vpr build && vpr --filter='./examples/*' build",
    "test:examples": "vpr test:contracts",
    "ready:examples": "vpr build:examples && vpr test:examples",
    "ci": "vpr ready && vpr ready:examples",
    "bench": "NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "bench:write": "WRITE_BASELINE=1 NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "deps:lint": "knip",
    "deps:fix": "knip --fix && pnpm store prune",
    "skills": "vpx skills@latest",
    "prepare": "vp config",
    "change": "changeset",
    "change:deps": "node scripts/auto-changeset.js",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@zintljs/testing": "workspace:*",
    "knip": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
