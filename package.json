{
  "name": "zintl-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run -F '@zintl/*' -F 'zintl' -F 'website' --parallel dev ",
    "build": "vpr --transitive zintl#build",
    "ready": "vp lint && knip && vp run build && vp test  && vp fmt && vp run bench ",
    "examples:dev": "pnpm run --filter='./examples/*' --parallel dev",
    "examples:build": "vpr --filter='./examples/*' build",
    "examples:test": "vp test --config=vitest.examples.config.ts",
    "examples:ready": "vpr examples:build && vpr examples:test",
    "bench": "NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "bench:write": "WRITE_BASELINE=1 NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "deps:lint": "knip",
    "deps:fix": "knip --fix && pnpm store prune",
    "skills": "vpx skills@latest",
    "prepare": "vp config",
    "change": "changeset",
    "change:deps": "node scripts/auto-changeset.js",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
