{
  "name": "zintl-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp lint && knip && vp run build && vp test  && vp fmt && vp run bench ",
    "dev": "pnpm run -F '@zintl/*' -F 'zintl' -F 'website' --parallel dev ",
    "build": "vp run -r build",
    "bench:write": "WRITE_BASELINE=1 NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "bench": "NODE_OPTIONS=\"--expose-gc\" vp test bench --run",
    "deps": "vpx taze@latest -Ilwr",
    "deps:major": "vpx taze@latest major -Ilwr",
    "deps:lint": "knip",
    "deps:fix": "knip --fix && pnpm store prune",
    "skills": "vpx skills@latest",
    "prepare": "vp config",
    "change": "changeset",
    "change:deps": "node scripts/auto-changeset.js",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "knip": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
