    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About - Zintl MPA Example</title>
    <!--zintl-bootstrap-->
    <script type="module" crossorigin src="/assets/about.js"></script>
    <link rel="modulepreload" crossorigin href="/assets/icons.js">
    <link rel="stylesheet" crossorigin href="/assets/icons-CSTk0DDQ.css">
  
  <!--zintl-bootstrap-->
    <script id="zintl-projection">
      (function() {
        const l = localStorage.getItem('zintl-locale') || 'en';
        const rtl = ["ar"];
        const deltas = {"ar":{"title":"حول - مثال Zintl MPA"},"es":{"title":"Acerca de - Ejemplo de Zintl MPA"},"zh":{"title":"关于 - Zintl MPA 示例"}};
        const originals = {
        title: document.title,
      };
        const preloads = {"ar":["assets/entry_b_4f8017c0589a.js","assets/entry_b_c087d0722440.js"],"es":["assets/entry_b_4f8017c0589a2.js","assets/entry_b_c087d07224402.js"],"zh":["assets/entry_b_4f8017c0589a3.js","assets/entry_b_c087d07224403.js"]};
      function preload(locale) {
        const urls = preloads[locale] || [];
        for (const url of urls) {
          const link = document.createElement("link");
          link.rel = "modulepreload";
          link.href = url;
          document.head.appendChild(link);
        }
      }
        function apply(locale) {
          if (document.documentElement.lang === locale) return;
          document.documentElement.dir = rtl.includes(locale) ? 'rtl' : 'ltr';
          document.documentElement.lang = locale;
          const hasText = v => typeof v === "string" && v.trim();
          const delta = deltas[locale];
          if (delta) {
            document.title = hasText(delta.title)
              ? delta.title
              : originals.title;
          } else {
            document.title = originals.title;
          }
        }
        window.__zintlApplyHtml = apply;
        if (l !== 'en') {
          apply(l);
          preload(l);
        }
      })();
    </script>
  </head>
  <body>
    <div id="app"></div>
  </body>
</html>
"
`;

