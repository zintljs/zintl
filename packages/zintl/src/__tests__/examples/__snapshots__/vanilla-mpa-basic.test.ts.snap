//#region examples/vanilla-mpa-basic/src/switcher.ts
function setupSwitcher(element, onSwitch) {
	const lang = new URLSearchParams(window.location.search).get("lang") || "en";
	element.innerHTML = [
		{
			id: "en",
			name: "English"
		},
		{
			id: "ar",
			name: "العربية"
		},
		{
			id: "es",
			name: "Español"
		},
		{
			id: "zh",
			name: "中文"
		}
	].map((l) => \`
    <!-- @zintl-ignore -->
    <button data-lang="\${l.id}" class="\${lang === l.id ? "active" : ""}">
      \${l.name}
    </button>
  \`).join("");
	element.querySelectorAll("button").forEach((btn) => {
		btn.addEventListener("click", () => {
			const newLang = btn.dataset.lang;
			onSwitch(newLang);
		});
	});
}
//#endregion
