    // Hydrate the app with the new locale's translations
    await (globalThis.__zintl_inst = loadI18nInstance({ locale: currentLocale, loaders: { ["b_612e1169e238"]: _zintl_mgr_b_612e1169e238.loader, ["b_41f76352d384"]: _zintl_mgr_b_612e1169e238.loader } }));

    // Update Header
