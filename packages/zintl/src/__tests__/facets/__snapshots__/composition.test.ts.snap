exports[`resolved facet composition per example > custom-facets (client) 1`] = `
"frameworks: (none)
bundler: vite
ssr: false

facets (resolution order):
  client-spa  [runtime]  priority=100
  vanilla-extraction  [extraction]  priority=100
  html-extraction  [extraction]  priority=100
  system-html-projection  [content]  priority=100
  system-static-assets  [content]  priority=100
  vite  [bundler]  priority=100

flags:
  absorbsStructuralChange: true
  clientLocaleSync: true
  dependencyInvalidation: false
  entryReexecutionSafe: true
  hmr: true
  hotUpdate: true
  htmlFanOut: true
  jsx: false
  jsxRichText: false
  localeRouting: true
  repaintsOnCatalogUpdate: false
  serverRequestScope: false
  sfc: false
  sfcBlockRequestsCarryWholeFile: false
  ssr: false
  streaming: false

extraction:
  extensions: .html, .js, .mjs, .mts, .ts
  targets: 19
  sfcRules: 0
  suppressionRules: 0
  mustacheRules: 0
  codegenFacets: (none)

single-provider hooks — declared by (winner first):
  wrapCode: (none)
  resolveVirtualPath: vite
  isVirtualId: vite
  dynamicImportTemplate: vite
  hmrInjectionCode: vite
  hmrSelfAcceptCode: vite
  detectLocale: (none)

single-provider hooks — resolved on the system view:
  ssrWrapCode: absent
  resolveVirtualPath: present
  isVirtualId: present
  dynamicImportTemplate: present
  hmrInjectionCode: present
  hmrSelfAcceptCode: present

ssr:
  entryTargets: 0
  wrapExports: (none)
  wrapDefault: undefined

activation trace:
  ✗ react-extraction             when.framework=react ✗ (detected: none)
  ✗ react-codegen                when.framework=react ✗ (detected: none)
  ✗ react-runtime                when.framework=react ✗ (detected: none)
