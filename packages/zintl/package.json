{
  "name": "zintljs",
  "version": "0.1.0-alpha.8",
  "description": "Compile-time internationalization for Vite — no keys, no wrappers, and only the translations each screen actually needs.",
  "keywords": [
    "code-splitting",
    "compile-time",
    "compiler",
    "hmr",
    "i18n",
    "i18n-compiler",
    "i18n-tool",
    "internationalization",
    "intl",
    "l10n",
    "locale",
    "localization",
    "react",
    "rtl",
    "ssr",
    "svelte",
    "translation",
    "vanilla",
    "vite",
    "vite-plugin",
    "vue",
    "zero-runtime",
    "zintl"
  ],
  "homepage": "https://github.com/zintljs/zintl#readme",
  "bugs": {
    "url": "https://github.com/zintljs/zintl/issues"
  },
  "license": "MIT",
  "author": "Khalid F. Shuhail <dev.khalid@me.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zintljs/zintl.git",
    "directory": "packages/zintl"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./macro": {
      "types": "./dist/macro.d.mts",
      "import": "./dist/macro.mjs"
    },
    "./facets": {
      "types": "./dist/facets.d.mts",
      "import": "./dist/facets.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@zintljs/compiler": "workspace:*",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
