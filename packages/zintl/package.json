{
  "name": "zintl",
  "version": "0.1.0-alpha.5",
  "description": "Vite plugin for Zintl automation",
  "keywords": [
    "automation",
    "automation-tool",
    "hmr",
    "i18n",
    "i18n-compiler",
    "i18n-tool",
    "internationalization",
    "intl",
    "l10n",
    "locale",
    "localization",
    "react",
    "svelte",
    "vite",
    "vite-plugin",
    "vue",
    "zintl"
  ],
  "bugs": {
    "url": "https://github.com/zintl/zintl/issues"
  },
  "license": "MIT",
  "author": "Khalid FSh",
  "repository": {
    "type": "git",
    "url": "https://github.com/zintl/zintl.git",
    "directory": "packages/zintl"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./macro": {
      "types": "./dist/macro.d.mts",
      "import": "./dist/macro.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@zintl/compiler": "workspace:*",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  }
}
