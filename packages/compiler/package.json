{
  "name": "@zintl/compiler",
  "version": "0.1.0-alpha.5",
  "description": "Bundler-agnostic compiler intelligence for Zintl",
  "license": "MIT",
  "author": "Khalid FSh",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "bench": "node --experimental-strip-types scripts/run-bench.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@zintl/extractor": "workspace:*",
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
