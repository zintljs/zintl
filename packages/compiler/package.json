{
  "name": "@zintl/compiler",
  "version": "0.1.0-alpha.0",
  "description": "Bundler-agnostic compiler intelligence for Zintl",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/runtime/store.ts src/runtime/resolver.ts src/runtime/registry.ts src/runtime/internal.ts --dts",
    "dev": "vp pack src/index.ts src/runtime/store.ts src/runtime/resolver.ts src/runtime/registry.ts src/runtime/internal.ts --dts --watch",
    "test": "vp test",
    "check": "vp check",
    "bench": "node --experimental-strip-types scripts/run-bench.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@zintl/extractor": "workspace:*",
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
