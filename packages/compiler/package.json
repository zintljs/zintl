{
  "name": "@zintljs/compiler",
  "version": "0.1.0-alpha.20",
  "description": "Bundler-agnostic compiler intelligence for Zintl",
  "keywords": [
    "compiler",
    "i18n",
    "i18n-compiler",
    "icu",
    "internationalization",
    "intl",
    "l10n",
    "localization",
    "zintl"
  ],
  "homepage": "https://github.com/zintljs/zintl/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/zintljs/zintl/issues"
  },
  "license": "MIT",
  "author": "Khalid F. Shuhail <dev.khalid@me.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zintljs/zintl.git",
    "directory": "packages/compiler"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./facets": {
      "types": "./dist/facet/index.d.mts",
      "import": "./dist/facet/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "bench": "node --experimental-strip-types scripts/run-bench.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@zintljs/extractor": "workspace:*",
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
