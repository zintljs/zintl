"import "./modulepreload-polyfill.js";
import { a as typescript_default, i as vite_default, n as setupSwitcher, r as hero_default, t as icons_default } from "./icons4.js";
//#region examples/vanilla-mpa-baked-i18n/src/index.ts?zintl-multiplex=es
var iconsDiv = document.createElement("div");
iconsDiv.id = "__icons__";
iconsDiv.style.display = "none";
iconsDiv.innerHTML = icons_default;
document.body.insertBefore(iconsDiv, document.body.firstChild);
document.querySelector("#app").innerHTML = \`
  <section id="header">
    <div id="switcher" class="switcher"></div>
    <div class="vertical-ticks"></div>
    <div class="icon-border">
      <svg class="icon" role="img" aria-hidden="true"><use href="#translate-icon"></use></svg>
    </div>
  </section>

  <div class="ticks"></div>

  <section id="center">
    <div class="hero">
      <img src="\${hero_default}" class="base" width="170" height="179">
      <img src="\${typescript_default}" class="framework" alt="TypeScript logo"/>
      <img src="\${vite_default}" class="vite" alt="Vite logo" />
    </div>
    <div>
      <h1>Bienvenido a la página de inicio de Zintl MPA</h1>
      <p>Esta es la página de inicio de nuestro ejemplo de aplicación multipágina.</p>
    </div>
    <a href="about.html" class="counter">Ir a la página de información</a>
  </section>

  <div class="ticks"></div>
  <section id="spacer"></section>
\`;
setupSwitcher(document.querySelector("#switcher"));
//#endregion
"
`;

