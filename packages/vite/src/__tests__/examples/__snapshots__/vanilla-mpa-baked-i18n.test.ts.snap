exports[`Example Proof: vanilla-mpa-baked-i18n > should match Final Production Build (dist) snapshots > vanilla-mpa-baked-i18n/dist/index.html 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting...</title>
    <script id="zintl-multiplex-redirect">
      (function() {
        try {
          const lang = (navigator.language || 'en').split('-')[0];
          const supported = ["en","ar","es","zh"];
          const target = supported.includes(lang) ? lang : 'en';
          const path = window.location.pathname.replace(/^\\/+/, '');
          window.location.replace('/' + target + '/' + path + window.location.search + window.location.hash);
        } catch (e) {
          const path = window.location.pathname.replace(/^\\/+/, '');
          window.location.replace('/en/' + path);
        }
      })();
    </script>
  </head>
  <body>
  </body>
</html>"
`;

