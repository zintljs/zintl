exports[`Example Proof: vanilla-spa-i18n-baked > should match Final Production Build (dist) snapshots > vanilla-spa-i18n-baked/dist/index.html 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting...</title>
    <script id="zintl-multiplex-redirect">
      (function() {
        try {
          const lang = (navigator.language || 'en').split('-')[0];
          const supported = ["en","ar","es","zh"];
          const target = supported.includes(lang) ? lang : 'en';
          window.location.replace('/' + target + '/');
        } catch (e) {
          window.location.replace('/en/');
        }
      })();
    </script>
  </head>
  <body>
  </body>
</html>"
`;

