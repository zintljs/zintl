      switch(locale) { 
        case "en":
          return {
    "b_src_main": {
      "Get started": "Get started",
      "Edit": "Edit",
      "and save to test": "and save to test",
      "Documentation": "Documentation",
      "Your questions, answered": "Your questions, answered",
      "Explore Vite": "Explore Vite",
      "Learn more": "Learn more",
      "Connect with us": "Connect with us",
      "Join the Vite community": "Join the Vite community",
    },
    "b_src_counter_setupCounter": {
      "Count is {counter}": (params) => {
    const { counter } = params;
    return \`Count is \${params['counter']}\`;
  },
    },
  };
                case "ar":
          return import("virtual:zintl/content/ar/entry:b_src_main").then(m => m.default);
        case "es":
          return import("virtual:zintl/content/es/entry:b_src_main").then(m => m.default);
        case "zh":
          return import("virtual:zintl/content/zh/entry:b_src_main").then(m => m.default);
        default: return {};
      }
    } };"
`;

