import _zintl_mgr_b_src_main_render from "virtual:zintl/manager/none/entry:b_src_main_render";


export function setupCounter(element: HTMLButtonElement) {
  let counter = 0;
  const setCounter = (count: number) => {
    counter = count;
    // @zintl-note This is a note for the compiler
    element.innerHTML = _t("{counter, plural, =0 {Start Counting Now!} one {Count is One.} =2 {Count is Two} other {Count is #}}", { counter }, { _mgr: _zintl_mgr_b_src_main_render, _bId: "b_src_counter_setupCounter" });
