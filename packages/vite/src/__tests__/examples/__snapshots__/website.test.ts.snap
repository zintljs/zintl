    <script type="module" crossorigin src="/assets/index-cP7leHyS.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-PpzFsM6_.css">
  <!--zintl-bootstrap-->
    <script id="zintl-projection">
      (function() {
        const params = new URLSearchParams(window.location.search);
        const l = params.get("lang") || "en" || localStorage.getItem('zintl-locale') || 'en';
        const rtl = ["ar"];
        const deltas = {"ar":{"title":"موقع الويب"}};
        const originals = {
          title: document.title,
        };
        const preloads = {"ar":["assets/entry_b_ae1e7cbb2f74-BNWsTriX.js"],"es":["assets/entry_b_ae1e7cbb2f74-gfFkWwHV.js"]};
        function preload(locale) {
          const urls = preloads[locale] || [];
          for (const url of urls) {
            const link = document.createElement("link");
            link.rel = "modulepreload";
            link.href = url;
            document.head.appendChild(link);
          }
        }
        function apply(locale) {
          if (document.documentElement.lang === locale) return;
          document.documentElement.dir = rtl.includes(locale) ? 'rtl' : 'ltr';
          document.documentElement.lang = locale;
          const hasText = v => typeof v === "string" && v.trim();
          const delta = deltas[locale];
          if (delta) {
            document.title = hasText(delta.title)
              ? delta.title
              : originals.title;
          } else {
            document.title = originals.title;
          }
        }
        window.__zintlApplyHtml = apply;
        if (l !== 'en') {
          apply(l);
          preload(l);
        }
      })();
    </script>
  </head>
  <body>
    <div id="app"></div>
  </body>
</html>
"
`;

